{
  "name": "smooth-components",
  "description": "A collection of smooth and elegant React components for building modern web applications.",
  "version": "1.1.36",
  "type": "module",
  "author": "Jaime Torres",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/smooth-components.umd.cjs",
  "module": "./dist/smooth-components.js",
  "types": "./dist/smooth-components.d.ts",
  "exports": {
    ".": {
      "import": "./dist/smooth-components.js",
      "require": "./dist/smooth-components.umd.cjs"
    },
    "./dist/smooth-components.css": "./dist/smooth-components.css"
  },
  "scripts": {
    "dev": "vite --port 1111 --open",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "release:patch": "npm version patch && npm run build && npm publish",
    "release:minor": "npm version minor && npm run build && npm publish",
    "release:major": "npm version major && npm run build && npm publish",
    "release:prepatch": "npm version prepatch && npm run build && npm publish --tag next",
    "release:preminor": "npm version preminor && npm run build && npm publish --tag next",
    "release:premajor": "npm version premajor && npm run build && npm publish --tag next"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "react",
    "components",
    "smooth",
    "elegant",
    "modern",
    "web",
    "application",
    "development",
    "poster",
    "cinema"
  ],
  "dependencies": {
    "motion": "^12.42.2"
  }
}
